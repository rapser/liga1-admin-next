# Firebase Client SDK (Público - para el navegador)
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=liga1-739fc.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=liga1-739fc
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=liga1-739fc.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK (Privado - solo para servidor)
FIREBASE_ADMIN_PROJECT_ID=liga1-739fc
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Secreto para trabajos programados (Vercel Cron y disparo manual de /api/weather/refresh).
# Vercel lo envía como cabecera `Authorization: Bearer $CRON_SECRET` en cada cron.
# Genera uno con: openssl rand -hex 32
CRON_SECRET=

# Sincronización automática de partidos (apagada por seguridad al desplegar)
LIVE_SYNC_ENABLED=false
# Fuente única de resultados en vivo.
ESPN_BASE_URL=https://site.api.espn.com/apis/site/v2/sports/soccer/per.1
LIGA1_SEASON=2026
# Monitor individual: consulta cada 45 s y se autocierra como máximo a las 6 h.
LIVE_MONITOR_INTERVAL_MS=45000
LIVE_MONITOR_MAX_DURATION_MS=21600000
LIVE_SYNC_BASE_URL=http://localhost:3100
